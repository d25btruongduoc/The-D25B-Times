rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Cost-safe admin check (no get/exists) for allow list queries
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'd25b.truongduoc@gmail.com';
    }

    // Full admin check for single-document operations
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPreferredClass(val) {
      return val is string && val.size() >= 3 && val.size() <= 4 && val in ['ALL', 'D25A', 'D25B', 'D25C', 'D25D'];
    }

    function isValidAuthProvider(val) {
      return val is string && val.size() >= 8 && val.size() <= 12 && val in ['password', 'google.com'];
    }

    function isValidAccentColor(val) {
      return val is string && val.size() >= 4 && val.size() <= 10 && val in ['cyan', 'emerald', 'violet', 'amber'];
    }

    function isValidBoundedIdList(listVal, maxLen) {
      return listVal is list &&
        listVal.size() <= maxLen &&
        (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() >= 1 && listVal[0].size() <= 100));
    }

    function isValidMemberProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'authProvider',
          'consentAccepted',
          'customName',
          'avatarUrl',
          'bio',
          'accentColor',
          'autoDriveBackup',
          'driveBackupFileId',
          'completedDeadlineIds',
          'bookmarkedCourseIds',
          'preferredClass',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'authProvider',
          'consentAccepted',
          'customName',
          'avatarUrl',
          'bio',
          'accentColor',
          'autoDriveBackup',
          'driveBackupFileId',
          'completedDeadlineIds',
          'bookmarkedCourseIds',
          'preferredClass',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        isValidAuthProvider(data.authProvider) &&
        data.consentAccepted is bool && data.consentAccepted == true &&
        data.customName is string && data.customName.size() <= 60 &&
        data.avatarUrl is string && data.avatarUrl.size() <= 65000 &&
        data.bio is string && data.bio.size() <= 240 &&
        isValidAccentColor(data.accentColor) &&
        data.autoDriveBackup is bool &&
        data.driveBackupFileId is string && data.driveBackupFileId.size() <= 128 &&
        isValidBoundedIdList(data.completedDeadlineIds, 150) &&
        isValidBoundedIdList(data.bookmarkedCourseIds, 80) &&
        isValidPreferredClass(data.preferredClass) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidForumPost(data, postId) {
      return data.keys().hasAll([
          'postId',
          'authorUid',
          'authorName',
          'authorAvatar',
          'category',
          'title',
          'content',
          'attachmentUrl',
          'visibility',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'postId',
          'authorUid',
          'authorName',
          'authorAvatar',
          'category',
          'title',
          'content',
          'attachmentUrl',
          'visibility',
          'createdAt',
          'updatedAt'
        ]) &&
        data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 128 && data.postId == postId &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
        data.authorAvatar is string && data.authorAvatar.size() <= 65000 &&
        data.category is string && data.category.size() >= 4 && data.category.size() <= 12 && data.category in ['study', 'resources', 'chat', 'team'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 3000 &&
        data.attachmentUrl is string && data.attachmentUrl.size() <= 300 &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidForumComment(data, postId, commentId) {
      return data.keys().hasAll([
          'commentId',
          'postId',
          'authorUid',
          'authorName',
          'authorAvatar',
          'content',
          'visibility',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'commentId',
          'postId',
          'authorUid',
          'authorName',
          'authorAvatar',
          'content',
          'visibility',
          'createdAt'
        ]) &&
        data.commentId is string && data.commentId.size() >= 1 && data.commentId.size() <= 128 && data.commentId == commentId &&
        data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 128 && data.postId == postId &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
        data.authorAvatar is string && data.authorAvatar.size() <= 65000 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp;
    }

    function isValidForumChatMessage(data, messageId) {
      return data.keys().hasAll([
          'messageId',
          'authorUid',
          'authorName',
          'authorAvatar',
          'text',
          'visibility',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'messageId',
          'authorUid',
          'authorName',
          'authorAvatar',
          'text',
          'visibility',
          'createdAt'
        ]) &&
        data.messageId is string && data.messageId.size() >= 1 && data.messageId.size() <= 128 && data.messageId == messageId &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
        data.authorAvatar is string && data.authorAvatar.size() <= 65000 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 800 &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp;
    }

    function isValidAdminRole(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.role is string && data.role.size() == 5 && data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidSheetsSyncConfig(data) {
      return data.keys().hasAll([
          'spreadsheetId',
          'spreadsheetUrl',
          'spreadsheetTitle',
          'lastSyncedAt',
          'lastSyncedCount',
          'updatedByUid'
        ]) &&
        data.keys().hasOnly([
          'spreadsheetId',
          'spreadsheetUrl',
          'spreadsheetTitle',
          'lastSyncedAt',
          'lastSyncedCount',
          'updatedByUid'
        ]) &&
        data.spreadsheetId is string && data.spreadsheetId.size() >= 1 && data.spreadsheetId.size() <= 128 &&
        data.spreadsheetUrl is string && data.spreadsheetUrl.size() >= 1 && data.spreadsheetUrl.size() <= 300 &&
        data.spreadsheetTitle is string && data.spreadsheetTitle.size() >= 1 && data.spreadsheetTitle.size() <= 150 &&
        data.lastSyncedAt is timestamp &&
        data.lastSyncedCount is int && data.lastSyncedCount >= 0 && data.lastSyncedCount <= 100000 &&
        data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
        data.updatedByUid == request.auth.uid;
    }

    // 1. Member email, personal home & backed-up app activity (PII strictly isolated)
    match /members/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isBootstrappedAdmin());

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidMemberProfile(incoming(), userId) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidMemberProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().authProvider == existing().authProvider &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'email',
              'customName',
              'avatarUrl',
              'bio',
              'accentColor',
              'autoDriveBackup',
              'driveBackupFileId',
              'completedDeadlineIds',
              'bookmarkedCourseIds',
              'preferredClass',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Public Community Forum Posts (no PII stored)
    match /forum_posts/{postId} {
      allow get: if isValidId(postId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      allow create: if isValidId(postId) &&
        isVerifiedUser() &&
        isValidForumPost(incoming(), postId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(postId) &&
        isVerifiedUser() &&
        isValidForumPost(incoming(), postId) &&
        incoming().postId == existing().postId &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            request.auth.uid == existing().authorUid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'authorName',
              'authorAvatar',
              'category',
              'title',
              'content',
              'attachmentUrl',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(postId) && isVerifiedUser() && (
        isAdmin() || request.auth.uid == existing().authorUid
      );

      // Pillar 1 Master Gate: comments require existing parent post
      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId) &&
          exists(/databases/$(database)/documents/forum_posts/$(postId)) &&
          existing().visibility == 'public';
        allow list: if existing().visibility == 'public';

        allow create: if isValidId(postId) && isValidId(commentId) &&
          isVerifiedUser() &&
          isValidForumComment(incoming(), postId, commentId) &&
          incoming().authorUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/forum_posts/$(postId));

        allow delete: if isValidId(postId) && isValidId(commentId) &&
          isVerifiedUser() &&
          exists(/databases/$(database)/documents/forum_posts/$(postId)) && (
            isAdmin() || request.auth.uid == existing().authorUid
          );
      }
    }

    // 3. Real-time Forum Community Chat (no PII stored)
    match /forum_chat/{messageId} {
      allow get: if isValidId(messageId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      allow create: if isValidId(messageId) &&
        isVerifiedUser() &&
        isValidForumChatMessage(incoming(), messageId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time;

      allow delete: if isValidId(messageId) && isVerifiedUser() && (
        isAdmin() || request.auth.uid == existing().authorUid
      );
    }

    // 4. Trusted admin role documents (no self-assignment)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(userId) &&
        isBootstrappedAdmin() &&
        isValidAdminRole(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(userId) &&
        isBootstrappedAdmin() &&
        isValidAdminRole(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && isBootstrappedAdmin();
    }

    // 5. Admin-only Google Sheets export config
    match /app_config/{configId} {
      allow get: if isValidId(configId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(configId) &&
        isAdmin() &&
        isValidSheetsSyncConfig(incoming()) &&
        incoming().lastSyncedAt == request.time;
      allow update: if isValidId(configId) &&
        isAdmin() &&
        isValidSheetsSyncConfig(incoming()) &&
        incoming().lastSyncedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'spreadsheetId',
          'spreadsheetUrl',
          'spreadsheetTitle',
          'lastSyncedAt',
          'lastSyncedCount',
          'updatedByUid'
        ]);
      allow delete: if isValidId(configId) && isBootstrappedAdmin();
    }

    // 6. Connection probe document for startup health check
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
    }
  }
}
